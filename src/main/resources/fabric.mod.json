  "authors": [
    "557"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/serverevents",
    "sources": "https://github.com/sucj/serverevents",
    "issues": "https://github.com/sucj/serverevents/issues"
  },
  "license": "MIT",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "icu.suc.mc.serverevents.internal.Main"
    ]
